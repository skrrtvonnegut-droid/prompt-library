{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/skrrtvonnegut-droid/prompt-library/blob/main/schemas/catalog.schema.json",
  "title": "Prompt Library Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "invocation",
    "classification_policy",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "canonical_home",
        "classification",
        "purpose",
        "canonical_content",
        "registry",
        "agent_contract"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "canonical_home": {
          "const": "github"
        },
        "classification": {
          "const": "Public"
        },
        "purpose": {
          "type": "string",
          "minLength": 20
        },
        "canonical_content": {
          "const": "markdown"
        },
        "registry": {
          "const": "catalog.yml"
        },
        "agent_contract": {
          "const": "AGENTS.md"
        }
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activation",
        "patterns",
        "resolution_order",
        "ambiguity",
        "missing_artifact"
      ],
      "properties": {
        "activation": {
          "enum": ["explicit", "suggested", "automatic"]
        },
        "patterns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "resolution_order": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "artifact_id",
              "macro_alias",
              "canonical_path",
              "unique_name_or_tag"
            ]
          }
        },
        "ambiguity": {
          "enum": ["surface_candidates", "require_exact_match"]
        },
        "missing_artifact": {
          "enum": ["report_and_do_not_invent"]
        }
      }
    },
    "classification_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "forbidden", "private_material"],
      "properties": {
        "allowed": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["Public", "Professional Portfolio"]
          }
        },
        "forbidden": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["Personal Private", "Employer Confidential", "Secrets"]
          }
        },
        "private_material": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "name",
        "path",
        "domain",
        "summary",
        "macros",
        "tags",
        "status",
        "classification"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(prompt|skill)\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "kind": {
          "enum": ["prompt", "skill"]
        },
        "name": {
          "type": "string",
          "minLength": 3
        },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\.\\./).+\\.md$"
        },
        "domain": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "summary": {
          "type": "string",
          "minLength": 20
        },
        "macros": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "status": {
          "enum": ["draft", "active", "deprecated", "archived"]
        },
        "classification": {
          "enum": ["Public", "Professional Portfolio"]
        },
        "replaced_by": {
          "type": "string",
          "pattern": "^(prompt|skill)\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "supersedes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(prompt|skill)\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
